<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    
    <title>Angithi Restaurant | Best North Indian & Chinese Food in Raigarh</title>
    <meta name="description" content="Experience the best North Indian, Chinese, and Biryani at Angithi Restaurant in Raigarh. Visit us at Atal Chowk, Chhatamuda Bypass Road. Book a table or order online!">
    <meta name="keywords" content="Angithi Raigarh, Restaurant in Raigarh, North Indian food Raigarh, Biryani Raigarh, Angithi Menu">
    
    <script src="https://cdn.tailwindcss.com"></script>
    
    <script crossorigin src="https://unpkg.com/react@18/umd/react.production.min.js"></script>
    <script crossorigin src="https://unpkg.com/react-dom@18/umd/react-dom.production.min.js"></script>
    
    <script src="https://unpkg.com/@babel/standalone/babel.min.js"></script>
    
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>
<body class="bg-gray-50 text-gray-800 font-sans">
    <div id="root"></div>

    <script type="text/babel">
        const { useState } = React;

        // --- Pages ---
        const Home = ({ setPage }) => (
            <div class="text-center py-20 px-4">
                <h1 class="text-5xl font-bold text-orange-600 mb-4">Welcome to Angithi</h1>
                <p class="text-xl text-gray-600 mb-8 max-w-2xl mx-auto">Discover the authentic flavors of North Indian, Chinese, and mouth-watering Biryani right in the heart of Raigarh.</p>
                <div class="flex justify-center gap-4 flex-wrap">
                    <button onClick={() => setPage('Menu')} class="bg-orange-600 text-white px-8 py-3 rounded-full font-bold hover:bg-orange-700 transition">View Menu</button>
                    <a href="tel:+917024248605" class="bg-gray-800 text-white px-8 py-3 rounded-full font-bold hover:bg-gray-900 transition shadow-lg">Call to Order</a>
                </div>
            </div>
        );

        const Menu = () => (
            <div class="py-10 px-4 max-w-4xl mx-auto">
                <h2 class="text-3xl font-bold text-center mb-8 text-orange-600">Our Specialties</h2>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div class="bg-white p-6 rounded-lg shadow-md">
                        <h3 class="text-xl font-bold border-b pb-2 mb-2">North Indian</h3>
                        <p class="text-gray-600">Authentic curries, rich gravies, and freshly baked tandoori breads.</p>
                    </div>
                    <div class="bg-white p-6 rounded-lg shadow-md">
                        <h3 class="text-xl font-bold border-b pb-2 mb-2">Chinese</h3>
                        <p class="text-gray-600">Spicy, tangy, and delicious noodles, manchurian, and soups.</p>
                    </div>
                    <div class="bg-white p-6 rounded-lg shadow-md md:col-span-2 text-center">
                        <h3 class="text-xl font-bold border-b pb-2 mb-2">Signature Biryani</h3>
                        <p class="text-gray-600">Aromatic basmati rice cooked with secret spices and tender meat/veg options.</p>
                    </div>
                </div>
            </div>
        );

        const About = () => (
            <div class="py-10 px-4 max-w-4xl mx-auto text-center">
                <h2 class="text-3xl font-bold mb-6 text-orange-600">About Angithi</h2>
                <p class="text-lg text-gray-700 mb-6 leading-relaxed">
                    Angithi is a cherished casual dining haven in Raigarh where tradition meets innovation. 
                    Known for our commitment to quality ingredients, delightful flavors, and exceptional service, 
                    we invite you to savor a dining experience like no other. We also proudly offer a range of dietary options!
                </p>
                <div class="bg-orange-100 p-6 rounded-lg inline-block text-left">
                    <p><strong><i class="fas fa-clock text-orange-600 mr-2"></i>Hours:</strong> 11:00 AM – 11:00 PM (All Days)</p>
                    <p class="mt-2"><strong><i class="fas fa-map-marker-alt text-orange-600 mr-2"></i>Location:</strong> Atal Chowk, Chhatamuda Bypass Road, Sangitarai, Raigarh, Chhattisgarh</p>
                </div>
            </div>
        );

        const Contact = () => (
            <div class="py-10 px-4 max-w-lg mx-auto text-center">
                <h2 class="text-3xl font-bold mb-8 text-orange-600">Get in Touch</h2>
                <div class="flex flex-col gap-4">
                    <a href="https://wa.me/917024248605" target="_blank" class="flex items-center justify-center bg-green-500 text-white p-4 rounded-lg text-xl hover:bg-green-600 transition shadow">
                        <i class="fab fa-whatsapp mr-3 text-2xl"></i> Chat on WhatsApp
                    </a>
                    <a href="tel:+917024248605" class="flex items-center justify-center bg-blue-500 text-white p-4 rounded-lg text-xl hover:bg-blue-600 transition shadow">
                        <i class="fas fa-phone-alt mr-3 text-2xl"></i> +91 7024248605
                    </a>
                    <a href="https://instagram.com" target="_blank" class="flex items-center justify-center bg-gradient-to-r from-purple-500 to-pink-500 text-white p-4 rounded-lg text-xl hover:opacity-90 transition shadow">
                        <i class="fab fa-instagram mr-3 text-2xl"></i> Follow on Instagram
                    </a>
                </div>
            </div>
        );

        // --- Main App Component ---
        const App = () => {
            const [currentPage, setCurrentPage] = useState('Home');

            const renderPage = () => {
                switch(currentPage) {
                    case 'Home': return <Home setPage={setCurrentPage} />;
                    case 'Menu': return <Menu />;
                    case 'About': return <About />;
                    case 'Contact': return <Contact />;
                    default: return <Home setPage={setCurrentPage} />;
                }
            };

            return (
                <div class="flex flex-col min-h-screen">
                    {/* Navbar */}
                    <nav class="bg-white shadow-md p-4 sticky top-0 z-50">
                        <div class="max-w-6xl mx-auto flex flex-wrap justify-between items-center">
                            <div class="text-2xl font-extrabold text-orange-600 cursor-pointer" onClick={() => setCurrentPage('Home')}>
                                <i class="fas fa-fire mr-2"></i>Angithi
                            </div>
                            <div class="flex space-x-4 mt-4 sm:mt-0 w-full sm:w-auto justify-center">
                                {['Home', 'Menu', 'About', 'Contact'].map(page => (
                                    <button 
                                        key={page} 
                                        onClick={() => setCurrentPage(page)}
                                        class={`font-medium pb-1 border-b-2 ${currentPage === page ? 'border-orange-600 text-orange-600' : 'border-transparent text-gray-600 hover:text-orange-500 transition'}`}
                                    >
                                        {page}
                                    </button>
                                ))}
                            </div>
                        </div>
                    </nav>

                    {/* Dynamic Content */}
                    <main class="flex-grow flex items-center justify-center bg-gray-50">
                        {renderPage()}
                    </main>

                    {/* Footer */}
                    <footer class="bg-gray-900 text-white py-6 text-center">
                        <div class="flex justify-center space-x-6 mb-4">
                            <a href="https://wa.me/917024248605" target="_blank" class="text-green-400 hover:text-green-300 text-2xl"><i class="fab fa-whatsapp"></i></a>
                            <a href="tel:+917024248605" class="text-blue-400 hover:text-blue-300 text-2xl"><i class="fas fa-phone"></i></a>
                            <a href="https://instagram.com" target="_blank" class="text-pink-400 hover:text-pink-300 text-2xl"><i class="fab fa-instagram"></i></a>
                        </div>
                        <p class="text-sm text-gray-400">© 2026 Angithi Restaurant, Raigarh. All Rights Reserved.</p>
                    </footer>
                </div>
            );
        };

        const root = ReactDOM.createRoot(document.getElementById('root'));
        root.render(<App />);
    </script>
</body>
</html>

